#!/usr/bin/env bash
# usbip-detach [PORT]
#
# Detach usbip devices from this container and remove the local device
# nodes created by usbip-attach. Without a PORT argument every imported
# device is detached. Detach is local (vhci); the server keeps exporting.

set -euo pipefail

while getopts ":ph" opt; do
	case $opt in
	h)
		grep '^#' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	\?)
		echo "usbip-detach: invalid option -$OPTARG" >&2
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))
PORT=${1:-}

if [ "$(id -u)" -eq 0 ]; then SUDO=(); else SUDO=(sudo); fi

# map vhci device -> busnum before detaching (sysfs entries vanish after)
declare -A PRE_BUS
for d in $(ls /sys/bus/usb/devices 2>/dev/null | grep -v '^usb'); do
	if b=$(cat "/sys/bus/usb/devices/$d/busnum" 2>/dev/null); then
		PRE_BUS[$d]=$b
	fi
done

ports=$("${SUDO[@]}" usbip port 2>/dev/null | sed -n 's/^Port \([0-9]\+\):.*/\1/p' || true)
if [ -n "$PORT" ]; then
	if ! grep -qx "$PORT" <<<"$ports"; then
		echo "usbip-detach: port $PORT has no imported device" >&2
		exit 1
	fi
	ports=$PORT
elif [ -z "$ports" ]; then
	echo "no imported usbip devices"
	exit 0
fi

for p in $ports; do
	"${SUDO[@]}" usbip detach -p "$p" || true
done

sleep 0.5
for d in $(ls /sys/bus/usb/devices 2>/dev/null | grep -v '^usb'); do
	unset "PRE_BUS[$d]"
done

for d in "${!PRE_BUS[@]}"; do
	bus=${PRE_BUS[$d]}
	dir=$(printf '/dev/bus/usb/%03d' "$bus")
	if [ -d "$dir" ]; then
		"${SUDO[@]}" rm -f "$dir"/* 2>/dev/null || true
		"${SUDO[@]}" rmdir "$dir" 2>/dev/null || true
	fi
	echo "detached: $d"
done
echo "done"
