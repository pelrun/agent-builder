#!/usr/bin/env python3
"""zai-quota — check Z.ai GLM Coding Plan quota and usage.

Reads the API key from pi's auth store (~/.pi/agent/auth.json, entry "zai")
or the Z_AI_API_KEY environment variable. Queries the same undocumented
endpoints the z.ai dashboard uses; times are shown in Australia/Melbourne
by default (override with ZAI_TZ, e.g. ZAI_TZ=UTC).

Usage:
  zai-quota            quota windows (5h / weekly) with reset times
  zai-quota --json     raw quota/limit response as JSON
  zai-quota --models   per-model usage for the last 24h
  zai-quota --tools    per-tool (MCP) usage for the last 24h
  zai-quota --hours N  window size for --models/--tools (default 24)

Note: these endpoints are unofficial and may change without notice.
"""

import json
import os
import sys
import urllib.request
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo

BASE = "https://api.z.ai/api/monitor/usage"
DEFAULT_TZ = "Australia/Melbourne"
# Peak window: Mon-Fri 14:00-18:00 Asia/Shanghai. Off-peak gets a flat
# 50% discount for all models (peak = full rate). China has no DST, so
# this anchor is fixed.
PEAK_TZ = ZoneInfo("Asia/Shanghai")
PEAK_START_H, PEAK_END_H = 14, 18
PEAK_RATES = "rates: peak = full credit burn; off-peak = flat 50% discount, all models"


def get_key() -> str:
    key = os.environ.get("Z_AI_API_KEY")
    if key:
        return key
    auth = os.path.expanduser("~/.pi/agent/auth.json")
    try:
        with open(auth) as f:
            key = json.load(f)["zai"]["key"]
        if key:
            return key
    except (OSError, KeyError, ValueError):
        pass
    sys.exit(f"error: no API key (set Z_AI_API_KEY or add zai entry to {auth})")


def api_get(path: str, key: str) -> dict:
    req = urllib.request.Request(
        BASE + path, headers={"Authorization": f"Bearer {key}", "Accept": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            body = json.load(e)
        except Exception:
            body = {}
        sys.exit(f"error: HTTP {e.code} from {path}: {body.get('msg', e.reason)}")
    except urllib.error.URLError as e:
        sys.exit(f"error: cannot reach {BASE}: {e.reason}")


def fmt_ms(ms: int, tz) -> str:
    dt = datetime.fromtimestamp(ms / 1000, tz=timezone.utc).astimezone(tz)
    return dt.strftime("%a %d %b %Y %H:%M %Z (UTC%z)")


def peak_bounds(day):
    """Start/end datetimes of the peak window on a given Asia/Shanghai date."""
    return (
        datetime(day.year, day.month, day.day, PEAK_START_H, tzinfo=PEAK_TZ),
        datetime(day.year, day.month, day.day, PEAK_END_H, tzinfo=PEAK_TZ),
    )


def next_peak_start(from_day):
    """First peak start at or after the given Asia/Shanghai date."""
    d = from_day
    while d.weekday() >= 5:  # Sat/Sun (UTC+8 weekday; Mon=0)
        d += timedelta(days=1)
    return peak_bounds(d)[0]


def peak_state(now):
    """Return (active, start, end, next_start) for the peak window."""
    p8 = now.astimezone(PEAK_TZ)
    today = p8.date()
    is_weekday = today.weekday() < 5
    start, end = peak_bounds(today)
    if is_weekday and start <= p8 < end:
        return True, start, end, next_peak_start(today + timedelta(days=1))
    search_from = today if (is_weekday and p8 < start) else today + timedelta(days=1)
    return False, None, None, next_peak_start(search_from)


def show_peak(now, tz):
    """Print the peak-window line: definition, status, and time to boundary."""
    active, start, end, nxt = peak_state(now)
    now_p8 = now.astimezone(PEAK_TZ)
    nxt_start, nxt_end = peak_bounds(nxt.astimezone(PEAK_TZ).date())
    loc_start = nxt_start.astimezone(tz)
    loc_end = nxt_end.astimezone(tz)
    anchor = f"Mon\u2013Fri {PEAK_START_H:02d}:00\u2013{PEAK_END_H:02d}:00 UTC+8 (= {loc_start.strftime('%H:%M')}\u2013{loc_end.strftime('%H:%M')} {loc_start.strftime('%Z')})"
    if active:
        end_loc = end.astimezone(tz)
        mins = round((end - now_p8).total_seconds() / 60)
        print(f"Peak window ({anchor}): ACTIVE \u2014 ends {end_loc.strftime('%a %d %b %H:%M %Z')} (in {mins // 60}h {mins % 60:02d}m)")
    else:
        mins = round((nxt_start - now_p8).total_seconds() / 60)
        print(f"Peak window ({anchor}): off-peak now")
        print(f"  next peak: {loc_start.strftime('%a %d %b %H:%M %Z')} (in {mins // 60}h {mins % 60:02d}m)")
    print(f"  {PEAK_RATES}")


def rel_ms(ms: int) -> str:
    delta = datetime.fromtimestamp(ms / 1000, tz=timezone.utc) - datetime.now(timezone.utc)
    mins = round(delta.total_seconds() / 60)
    if mins < 0:
        return "overdue"
    h, m = divmod(mins, 60)
    return f"in {h}h {m:02d}m" if h else f"in {m}m"


def window_label(unit: int, number: int) -> str:
    # Observed: unit 3 = hours, unit 6 = weeks. Fall back to raw codes.
    return {3: f"{number}-hour", 6: f"{number}-week"}.get(unit, f"unit{unit} x{number}")


def show_quota(key: str, as_json: bool) -> None:
    resp = api_get("/quota/limit", key)
    if not resp.get("success"):
        sys.exit(f"error: API said: {resp.get('msg', resp)}")
    data = resp["data"]
    if as_json:
        print(json.dumps(data, indent=2))
        return
    tz = ZoneInfo(os.environ.get("ZAI_TZ", DEFAULT_TZ))
    level = data.get("level", "unknown")
    now_local = datetime.now(tz)
    print(f"Z.ai GLM Coding Plan ({level}) — quota as of {now_local.strftime('%a %d %b %Y %H:%M %Z')}")
    print()
    for w in data.get("limits", []):
        label = window_label(w.get("unit", 0), w.get("number", 0))
        limit, used = w.get("usage", 0), w.get("currentValue", 0)
        pct = w.get("percentage")
        reset = w.get("nextResetTime")
        remaining = w.get("remaining")
        line = f"{label} window: {used:,} / {limit:,} credits ({pct}%)"
        if remaining is not None:
            line += f", {remaining:,} left"
        print(line)
        if reset:
            print(f"  resets: {fmt_ms(reset, tz)} ({rel_ms(reset)})")
    print()
    show_peak(datetime.now(timezone.utc), tz)
    print("\nUnofficial endpoint — may change without notice.")


def show_usage_matrix(key: str, which: str, hours: int) -> None:
    tz = ZoneInfo(os.environ.get("ZAI_TZ", DEFAULT_TZ))
    end = datetime.now(timezone.utc)
    start = end - timedelta(hours=hours)
    # Endpoint expects naive "yyyy-MM-dd HH:mm:ss"; send UTC first, retry Melbourne-local.
    fmt = lambda d: d.strftime("%Y-%m-%d %H:%M:%S")
    for attempt in (fmt(start), fmt(start.astimezone(tz).replace(tzinfo=None))):
        q = f"/{which}-usage?startTime={urllib.request.quote(attempt)}&endTime={urllib.request.quote(fmt(end))}"
        resp = api_get(q, key)
        if resp.get("success") and resp.get("data") not in (None, [], {}):
            print(f"{which} usage, last {hours}h (hour buckets in server timezone):")
            print(json.dumps(resp["data"], indent=2))
            return
    print(f"No {which} usage data in the last {hours}h (or the endpoint changed): {resp.get('msg', resp)}")


def main() -> None:
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return
    key = get_key()
    if args and args[0] == "--json":
        show_quota(key, as_json=True)
    elif args and args[0] == "--models":
        hours = int(args[args.index("--hours") + 1]) if "--hours" in args else 24
        show_usage_matrix(key, "model", hours)
    elif args and args[0] == "--tools":
        hours = int(args[args.index("--hours") + 1]) if "--hours" in args else 24
        show_usage_matrix(key, "tool", hours)
    else:
        show_quota(key, as_json=False)


if __name__ == "__main__":
    main()
